{
  "name": "zerospikes",
  "version": "0.1.0",
  "description": "Performance limits for Playwright: frame times, input latency and memory, recorded like snapshots.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eliathx/zerospikes.git",
    "directory": "packages/zerospikes"
  },
  "homepage": "https://github.com/Eliathx/zerospikes#readme",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "zerospikes": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run build && node -e \"for (const f of ['README.md', 'LICENSE', 'CHANGELOG.md']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "keywords": [
    "performance",
    "playwright",
    "jank",
    "performance-budget",
    "frame-budget",
    "ci",
    "interaction"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.49"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
