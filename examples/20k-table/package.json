{
  "name": "zerospikes-example-20k-table",
  "private": true,
  "version": "0.1.0",
  "description": "A 20,000-row data grid with four performance mistakes to turn on, tested with zerospikes.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "perf": "npm run build && playwright test",
    "perf:update": "npm run build && playwright test -u",
    "perf:history": "zerospikes history",
    "perf:reliability": "node scripts/reliability.mjs",
    "perf:sensitivity": "node scripts/sensitivity.mjs",
    "perf:compare-reliability": "node scripts/compare-reliability.mjs",
    "perf:calibrate": "node scripts/calibrate-slack.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zerospikes": "*"
  }
}
